{
  "expo": {
    "name": "RetailPrime",
    "slug": "retailprime",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/retailprime-logo.png",
    "scheme": "retailprime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.inventorypro.qno66u"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/retailprime-logo.png",
        "backgroundColor": "#05091c"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.inventorypro.qno66u"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/retailprime-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RetailPrime to scan product barcodes and capture repair-condition photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow RetailPrime to capture repair-condition photos."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/retailprime-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#05091c"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
