:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#111827;background:#fefefe}*{box-sizing:border-box}body{margin:0;background:#f8f9fb}.app-shell{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.sidebar{background:#fff;border-right:1px solid #e5e7eb;padding:22px 12px;display:flex;flex-direction:column;gap:5px;position:sticky;top:0;height:100vh}.brand{font-size:22px;color:#667eea;padding:8px 11px 22px}.brand span{color:#111827;margin-left:6px}.sidebar button{border:0;background:transparent;padding:11px 12px;border-radius:11px;text-align:left;color:#374151;font-weight:650;font-size:14px}.sidebar button:hover,.sidebar button.active{background:#e8eaff;color:#667eea}.sidebar em{font-style:normal;font-size:19px;width:28px;display:inline-block}.sidebar .signout{margin-top:auto;color:#ef4444}.content{width:min(1240px,100%);margin:auto;padding:28px 34px 64px}.content>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.content header h1{margin:3px 0;font-size:28px}.content header small,.eyebrow,h3,.subhead{color:#6b7280;letter-spacing:1px;font-size:11px;font-weight:800}.content header div:last-child{display:flex;gap:9px;align-items:center}.content header button{border:0;border-radius:12px;width:40px;height:40px;background:#fff;color:#667eea;font-size:21px;box-shadow:0 2px 8px #1118270d}.avatar{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:50%;display:grid;place-items:center;width:38px;height:38px}.hero{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:20px;padding:26px;margin-bottom:25px;box-shadow:0 12px 26px #667eea36}.hero h2{margin:6px 0;font-size:27px}.hero p{margin:0;opacity:.85;font-size:13px}.hero small{color:#fff;opacity:.7}section{margin:23px 0}h3{margin:0 0 12px}.quick,.snapshot,.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.quick button{background:#fff;border:1px solid #e5e7eb;border-radius:14px;min-height:103px;color:#111827;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;box-shadow:0 4px 12px #1118270b}.quick em{font-style:normal;font-size:24px;background:#e8eaff;color:#667eea;border-radius:10px;padding:8px}.circles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.circles button{border:0;background:transparent;min-height:94px;color:#374151;display:flex;flex-direction:column;align-items:center;gap:7px;font-weight:650}.circles em{font-style:normal;background:#eef2ff;border:1px solid #d9ddff;color:#667eea;display:grid;place-items:center;width:56px;height:56px;border-radius:50%;font-size:23px}.panel{background:#fff;border:1px solid #e5e7eb;border-radius:15px;box-shadow:0 4px 12px #0f172a0c}.bars{padding:18px}.bars>div{height:145px;display:flex;align-items:end;gap:9px;padding-top:15px}.bars i{flex:1;border-radius:8px 8px 2px 2px;background:linear-gradient(#667eea,#764ba2);min-height:7px}.overview{padding:18px;display:grid;grid-template-columns:2fr repeat(3,1fr);gap:15px}.overview small,.snapshot small,.metrics small{display:block;color:#6b7280;font-size:12px}.overview strong{color:#667eea;font-size:27px;display:block;margin-top:5px}.overview b,.snapshot b,.metrics b{font-size:21px;display:block;margin-top:7px}.snapshot .panel,.metrics .panel{padding:16px}.actions{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.actions p,.subhead{letter-spacing:0;color:#6b7280;font-size:13px;font-weight:500}.actions button,.content>button,.modal button,.settings>button,.pos>section>button:last-child{background:#667eea;color:#fff;border:0;border-radius:10px;padding:11px 15px;font-weight:750}.list{display:grid;gap:10px}.record{padding:15px 17px;display:flex;justify-content:space-between;align-items:center;gap:15px}.record b{font-size:15px}.record p{color:#6b7280;font-size:12px;margin:5px 0 0}.record strong{color:#667eea;white-space:nowrap}.warning{color:#ef4444!important}.empty{padding:22px;text-align:center;color:#6b7280}.toast{background:#ecfdf5;color:#047857;padding:11px 14px;border-radius:10px;margin-bottom:14px;font-size:13px;cursor:pointer}.status,.ready{border:0;padding:8px 10px;border-radius:9px;background:#fffbeb;color:#b45309;font-weight:700}.ready{background:#ecfdf5;color:#047857}.modal{position:fixed;inset:0;background:#11182788;z-index:10;display:grid;place-items:center;padding:20px}.modal>div{background:#fff;border-radius:16px;width:min(560px,100%);padding:20px;max-height:90vh;overflow:auto}.modal header{display:flex;justify-content:space-between;align-items:center}.modal h2{margin:0}.modal header button{border:0;background:transparent;font-size:28px}.modal label,.settings label{display:grid;gap:6px;color:#374151;font-size:13px;font-weight:700;margin:13px 0}.modal input,.modal textarea,.modal select,.settings input,.pos input,.pos select,.search input{width:100%;border:1px solid #d1d5db;border-radius:10px;padding:11px;background:#fff;font:inherit}.modal textarea{height:250px;font-family:ui-monospace,monospace}.modal>div>button{margin-top:14px}.toggle,.filters{display:flex;gap:8px;margin:12px 0}.toggle button,.filters button{border:1px solid #d1d5db;background:#fff;border-radius:99px;padding:8px 13px;color:#374151}.toggle .selected,.filters .selected{background:#667eea;color:#fff;border-color:#667eea}.search{margin:5px 0 12px}.search input{font-size:16px;padding:14px}.settings{padding:18px;margin-bottom:13px}.settings h3{font-size:16px;color:#111827;letter-spacing:0}.settings p{font-size:13px;color:#6b7280}.pos{display:grid;grid-template-columns:1fr 380px;gap:16px}.pos section{margin:0;padding:17px}.product{width:100%;text-align:left;border:0;border-bottom:1px solid #f0f2f5;padding:11px 0;background:transparent;display:flex;justify-content:space-between;gap:8px}.product span{font-weight:650}.product b{font-size:12px;color:#667eea}.cart p{display:flex;justify-content:space-between;color:#374151;font-size:13px}.check{display:block;margin:12px 0;color:#374151;font-size:13px}.login{min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#667eea,#764ba2)}.login form{background:#fff;border-radius:20px;padding:30px;width:min(400px,92vw);box-shadow:0 20px 50px #11182742}.login i{font-style:normal;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:12px;font-weight:800;padding:10px;display:inline-block}.login h1{margin:13px 0 4px}.login p{color:#6b7280;font-size:13px}.login input{width:100%;border:1px solid #d1d5db;border-radius:10px;padding:12px;margin:6px 0}.login button{width:100%;border:0;border-radius:10px;padding:12px;background:#667eea;color:#fff;font-weight:700;margin-top:8px}.login .secondary{background:#f1f5f9;color:#334155}.login .link{background:transparent;color:#667eea}.login .error{color:#dc2626}.mobile-nav{display:none}@media(max-width:760px){.app-shell{display:block}.sidebar{display:none}.content{padding:18px 15px 88px}.quick,.snapshot,.metrics{grid-template-columns:repeat(2,1fr)}.circles{grid-template-columns:repeat(4,1fr);gap:4px}.circles button{font-size:10px}.content header h1{font-size:24px}.overview{grid-template-columns:repeat(2,1fr)}.pos{grid-template-columns:1fr}.mobile-nav{display:flex;position:fixed;z-index:9;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e5e7eb;justify-content:space-around;padding:7px}.mobile-nav button{border:0;background:transparent;color:#6b7280;display:grid;gap:2px;place-items:center;font-size:18px}.mobile-nav small{font-size:9px}.mobile-nav .active{color:#667eea}.hero{padding:20px}.quick button{min-height:88px}}
