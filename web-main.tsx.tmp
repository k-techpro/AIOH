import {useEffect,useMemo,useState} from "react";
import {createRoot} from "react-dom/client";
import {GoogleAuthProvider,createUserWithEmailAndPassword,onAuthStateChanged,signInWithEmailAndPassword,signInWithPopup,signOut,type User} from "firebase/auth";
import {collection,doc,onSnapshot,runTransaction,setDoc,updateDoc,increment} from "firebase/firestore";
import {app,auth,authPersistence,db,FIRESTORE_DATABASE_ID,recordPath} from "./firebase";
import "./styles.css";
type Row=Record<string,any>&{id:string}; type Page="dashboard"|"pos"|"customers"|"products"|"inventory"|"invoices"|"coupons"|"services"|"payments"|"expenses"|"transfers"|"shops"|"staff"|"attendance"|"notifications"|"settings"|"sales"|"reports"|"search"|"returns";
const names=["customers","products","inventoryMovements","invoices","coupons","services","payments","expenses","transfers","shops","staff","attendance","settings","sales","activities","returns"];
const rupee=(v:any)=>new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",maximumFractionDigits:0}).format(Number(v)||0);
const nice=(s:string)=>s.replace(/([A-Z])/g," $1").replace(/^./,c=>c.toUpperCase());
const clean=(v:any):any=>Array.isArray(v)?v.map(clean):v&&typeof v==="object"?Object.fromEntries(Object.entries(v).filter(([,x])=>x!==undefined&&x!==null&&!(typeof x==="number"&&!Number.isFinite(x))).map(([k,x])=>[k,clean(x)])):v;
// Kept at module scope only to avoid an unresolved JSX identifier; the invoice
// transaction calculates the authoritative total before every write.
const total=0;
function Login(){const[email,setEmail]=useState(""),[password,setPassword]=useState(""),[create,setCreate]=useState(false),[error,setError]=useState("");const submit=async(e:React.FormEvent)=>{e.preventDefault();try{await authPersistence;await(create?createUserWithEmailAndPassword(auth,email.trim(),password):signInWithEmailAndPassword(auth,email.trim(),password))}catch(x:any){setError(x.message)}};return <main className="login"><form onSubmit={submit}><i>RP</i><h1>RetailPrime</h1><p>Use the same Firebase business account as mobile.</p><input required type="email" placeholder="Email" value={email} onChange={e=>setEmail(e.target.value)}/><input required minLength={6} type="password" placeholder="Password" value={password} onChange={e=>setPassword(e.target.value)}/>{error&&<p className="error">{error}</p>}<button>{create?"Create account":"Sign in"}</button><button type="button" className="secondary" onClick={()=>signInWithPopup(auth,new GoogleAuthProvider()).catch((e:any)=>setError(e.message))}>Continue with Google</button><button type="button" className="link" onClick={()=>setCreate(!create)}>{create?"Already have an account?":"New user? Create an account"}</button></form></main>}
function App(){const[user,setUser]=useState<User|null>(null),[page,setPage]=useState<Page>("dashboard"),[data,setData]=useState<Record<string,Row[]>>({}),[message,setMessage]=useState("");useEffect(()=>onAuthStateChanged(auth,u=>{setUser(u);if(u)console.info("[FIREBASE DEBUG] Connected Firebase context",{projectId:app.options.projectId,appId:app.options.appId,uid:u.uid,firestoreDatabaseId:FIRESTORE_DATABASE_ID,firestorePath:`users/${u.uid}/businessData/customers/records`})}),[]);useEffect(()=>{if(!user)return;const stops=names.map(n=>onSnapshot(collection(db,...recordPath(user.uid,n)),s=>setData(x=>({...x,[n]:s.docs.map(d=>({id:d.id,...d.data()}))})),e=>setMessage(`${n}: ${e.message}`)));return()=>stops.forEach(s=>s())},[user]);if(!user)return <Login/>;const rows=(n:string)=>data[n]||[];const save=async(n:string,v:any,id?:string)=>{const ref=id?doc(db,...recordPath(user.uid,n),id):doc(collection(db,...recordPath(user.uid,n)));await setDoc(ref,clean({...v,id:id||ref.id,updatedAt:new Date().toISOString(),...(id?{}:{createdAt:new Date().toISOString()})}),{merge:!!id});setMessage(`${nice(n)} saved.`);return ref.id};return <div className="app-shell"><aside className="sidebar"><b className="brand">RP <span>RetailPrime</span></b>{([["dashboard","⌂"],["pos","⊕"],["customers","♙"],["products","◈"],["inventory","▤"],["invoices","▧"],["services","⚒"],["coupons","◇"],["reports","▥"],["search","⌕"],["notifications","◉"],["settings","⚙"]]as [Page,string][]).map(([p,i])=><button key={p} className={page===p?"active":""} onClick={()=>setPage(p)}><em>{i}</em>{p==="dashboard"?"Home":nice(p)}</button>)}<button className="signout" onClick={()=>signOut(auth)}>Sign out</button></aside><main className="content"><header><div><small>GOOD DAY</small><h1>{page==="dashboard"?"RetailPrime":nice(page)}</h1></div><div><button onClick={()=>setPage("search")}>⌕</button><button onClick={()=>setPage("notifications")}>◉</button><b className="avatar">{(user.email||"U")[0]}</b></div></header>{message&&<div className="toast" onClick={()=>setMessage("")}>{message}</div>}<Workspace page={page} setPage={setPage} rows={rows} save={save} user={user}/></main></div>}
function Workspace({page,setPage,rows,save,user}:{page:Page;setPage:(x:Page)=>void;rows:(x:string)=>Row[];save:(n:string,v:any,id?:string)=>Promise<string>;user:User}){if(page==="dashboard")return <Dashboard rows={rows} go={setPage}/>;if(page==="inventory")return <Inventory products={rows("products")} movements={rows("inventoryMovements")}/>;if(page==="notifications")return <Alerts products={rows("products")}/>;if(page==="reports")return <Reports invoices={rows("invoices")} products={rows("products")} customers={rows("customers")}/>;if(page==="settings")return <Settings user={user} rows={rows("settings")} save={save}/>;if(page==="search")return <Search rows={rows} go={setPage}/>;if(page==="services")return <Services rows={rows("services")} save={save}/>;if(page==="coupons")return <Coupons rows={rows("coupons")} save={save}/>;if(page==="pos")return <POS user={user} products={rows("products")} customers={rows("customers")} coupons={rows("coupons")} go={setPage}/>;if(page==="returns")return <Returns invoices={rows("invoices")} user={user}/>;return <Records name={page} rows={rows(page)} save={save}/>}
function Dashboard({rows,go}:{rows:(n:string)=>Row[];go:(x:Page)=>void}){const inv=rows("invoices"),products=rows("products"),customers=rows("customers"),services=rows("services"),today=new Date().toISOString().slice(0,10),sale=inv.filter(i=>String(i.created_at||i.createdAt||"").slice(0,10)===today).reduce((s,i)=>s+Number(i.total||0),0);const quick:[[Page,string,string],[Page,string,string],[Page,string,string],[Page,string,string]]=[["pos","⊕","New Sale"],["customers","♙","Customers"],["invoices","▧","Invoice"],["services","⚒","Services"]];const sets:[[string,[Page,string,string][]],[string,[Page,string,string][]],[string,[Page,string,string][]],[string,[Page,string,string][]]]=[["QUICK SALES",[["returns","↶","Return Product"],["pos","◷","Pay Later"],["invoices","◴","History"],["customers","♙","Walk-in List"]]],["INVENTORY",[["products","◈","Products"],["inventory","▤","Stock Check"],["notifications","!","Low Stock"],["inventory","▤","Inventory"]]],["BUSINESS",[["reports","▥","Reports"],["expenses","₹","Expenses"],["payments","▣","Payments"],["reports","⌁","Snapshot"]]],["OPERATIONS",[["staff","♙","Staff"],["attendance","✓","Attendance"],["notifications","◉","Alerts"],["settings","⚙","Settings"]]]];return <><section className="hero"><small>YOUR BUSINESS WORKSPACE</small><h2>Everything in one place.</h2><p>Live Firebase data · {inv.length} invoices</p></section><section><h3>QUICK START</h3><div className="quick">{quick.map(([p,i,l])=><button key={l} onClick={()=>go(p)}><em>{i}</em><b>{l}</b></button>)}</div></section>{sets.map(([h,items])=><section key={h}><h3>{h}</h3><div className="circles">{items.map(([p,i,l])=><button key={l} onClick={()=>go(p)}><em>{i}</em><span>{l}</span></button>)}</div></section>)}<section><h3>SALES PERFORMANCE</h3><div className="panel bars"><b>Last 7 days</b><div>{Array.from({length:7},(_,n)=>{const d=new Date();d.setDate(d.getDate()-6+n);const a=inv.filter(x=>String(x.created_at||x.createdAt||"").slice(0,10)===d.toISOString().slice(0,10)).reduce((s,x)=>s+Number(x.total||0),0);return <i key={n} title={rupee(a)} style={{height:`${Math.max(8,Math.min(100,a?100:a))}%`}}/>})}</div></div></section><section><h3>TODAY'S OVERVIEW</h3><div className="overview panel"><div><small>Total Sales</small><strong>{rupee(sale)}</strong></div><div><small>Orders</small><b>{inv.length}</b></div><div><small>Customers</small><b>{customers.length}</b></div><div><small>Pending</small><b>{inv.filter(x=>Number(x.balance_due)>0).length}</b></div></div></section><section><h3>BUSINESS SNAPSHOT</h3><div className="snapshot">{[["Products",products.length],["Low Stock",products.filter(p=>Number(p.stock)<=Number(p.min_stock??5)).length],["Out of Stock",products.filter(p=>Number(p.stock)<=0).length],["Active Services",services.length]].map(([l,n])=><div className="panel" key={String(l)}><small>{l}</small><b>{n}</b></div>)}</div></section></>}
function Records({name,rows,save}:{name:string;rows:Row[];save:(n:string,v:any,id?:string)=>Promise<string>}){const[open,setOpen]=useState(false),[text,setText]=useState("{}");return <><div className="actions"><p>{rows.length} live records</p><button onClick={()=>{setText(JSON.stringify({created_at:new Date().toISOString()},null,2));setOpen(true)}}>+ Add {nice(name)}</button></div><List rows={rows}/>{!rows.length&&<Empty text={`No ${nice(name).toLowerCase()} records yet.`}/>} {open&&<Modal title={`Add ${nice(name)}`} close={()=>setOpen(false)}><textarea value={text} onChange={e=>setText(e.target.value)}/><button onClick={async()=>{try{await save(name,JSON.parse(text));setOpen(false)}catch(e:any){alert(e.message)}}}>Save to Firebase</button></Modal>}</>}
function List({rows}:{rows:Row[]}){return <div className="list">{rows.map(r=><article className="panel record" key={r.id}><div><b>{r.name||r.invoice_number||r.code||r.customerName||r.serviceName||r.id}</b><p>{r.customer_name||r.phone||r.status||r.shop_id||r.created_at||r.createdAt||"Live Firebase record"}</p></div><strong>{r.total!==undefined?rupee(r.total):r.amount!==undefined?rupee(r.amount):""}</strong></article>)}</div>}
function Inventory({products,movements}:{products:Row[];movements:Row[]}){return <><p className="subhead">Mobile inventory is the <b>products</b> collection. Stock history is <b>inventoryMovements</b>; there is no mobile <code>inventory</code> collection.</p><h3>STOCK CHECK</h3><div className="list">{products.map(p=><article className="panel record" key={p.id}><div><b>{p.name}</b><p>{p.sku||"No SKU"} · Minimum {p.min_stock??5}</p></div><strong className={Number(p.stock)<=Number(p.min_stock??5)?"warning":""}>{p.stock??0} in stock</strong></article>)}</div><h3>INVENTORY MOVEMENTS</h3><List rows={movements}/>{!products.length&&<Empty text="No products yet."/>}</>}
function Alerts({products}:{products:Row[]}){const low=products.filter(p=>Number(p.stock)<=Number(p.min_stock??5));return <><p className="subhead">Mobile derives alerts from low-stock products. The live <code>notifications</code> collection is empty.</p><div className="list">{low.map(p=><article className="panel record" key={p.id}><em>!</em><div><b>{p.name}</b><p>{p.stock} left · reorder at {p.min_stock??5}</p></div></article>)}</div>{!low.length&&<Empty text="No inventory alerts. All products are above their minimum stock."/>}</>}
function Services({rows,save}:{rows:Row[];save:(n:string,v:any,id?:string)=>Promise<string>}){const[open,setOpen]=useState(false),[form,setForm]=useState<any>({customerName:"",customerPhone:"",product:"",complaint:"",expectedDelivery:"",serviceName:"",price:"",shop_id:"",status:"PENDING"});const submit=async()=>{if(!form.customerName||!form.product||!form.expectedDelivery||!form.serviceName||!Number(form.price))return alert("Complete customer, product, delivery date, service, and price.");await save("services",{...form,price:Number(form.price)});setOpen(false)};return <><div className="actions"><p>Persistent repair intake with a browser calendar.</p><button onClick={()=>setOpen(true)}>+ New Service</button></div><div className="list">{rows.map(x=><article className="panel record" key={x.id}><div><b>{x.customerName} · {x.product}</b><p>{x.serviceName} · Delivery {x.expectedDelivery} · {rupee(x.price)}</p></div><button className={x.status==="READY"?"ready":"status"} onClick={()=>save("services",{status:x.status==="READY"?"PENDING":"READY"},x.id)}>{x.status||"PENDING"}</button></article>)}</div>{!rows.length&&<Empty text="No service records yet."/>}{open&&<Modal title="New Repair Intake" close={()=>setOpen(false)}><Fields form={form} set={setForm} fields={[["Customer name","customerName"],["Phone","customerPhone"],["Product","product"],["Complaint","complaint"],["Expected delivery","expectedDelivery","date"],["Service name","serviceName"],["Price","price","number"],["Shop ID","shop_id"]]}/><div className="toggle"><button className={form.status==="PENDING"?"selected":""} onClick={()=>setForm({...form,status:"PENDING"})}>PENDING</button><button className={form.status==="READY"?"selected":""} onClick={()=>setForm({...form,status:"READY"})}>READY</button></div><button onClick={submit}>Save Service</button></Modal>}</>}
function Coupons({rows,save}:{rows:Row[];save:(n:string,v:any,id?:string)=>Promise<string>}){const[open,setOpen]=useState(false),[form,setForm]=useState<any>({code:"",discount:"",discountType:"fixed",endDate:"",usageLimit:"",enabled:true});const submit=async()=>{if(!form.code||!Number(form.discount))return alert("Coupon code and discount are required.");await save("coupons",{...form,code:form.code.trim().toUpperCase(),discount:Number(form.discount),usageLimit:form.usageLimit?Number(form.usageLimit):null,usageCount:0});setOpen(false)};return <><div className="actions"><p>Coupons are optional when completing a bill.</p><button onClick={()=>setOpen(true)}>+ New Coupon</button></div><div className="list">{rows.map(c=><article className="panel record" key={c.id}><div><b>{c.code}</b><p>{c.discountType||"fixed"} · {c.endDate||"No expiry"} · {c.enabled===false?"Disabled":"Active"}</p></div><strong>{c.discountType==="percentage"?`${c.discount}%`:rupee(c.discount)}</strong></article>)}</div>{!rows.length&&<Empty text="No coupons yet."/>}{open&&<Modal title="New Coupon" close={()=>setOpen(false)}><Fields form={form} set={setForm} fields={[["Code","code"],["Discount","discount","number"],["Expiry","endDate","date"],["Usage limit","usageLimit","number"]]}/><select value={form.discountType} onChange={e=>setForm({...form,discountType:e.target.value})}><option value="fixed">Fixed amount</option><option value="percentage">Percentage</option></select><button onClick={submit}>Save Coupon</button></Modal>}</>}
function Search({rows,go}:{rows:(n:string)=>Row[];go:(x:Page)=>void}){const[q,setQ]=useState(""),[kind,setKind]=useState("all");const found=useMemo(()=>{const text=q.toLowerCase();if(!text)return[];const all=[...rows("invoices").map(x=>({...x,_type:"Invoice"})),...rows("customers").map(x=>({...x,_type:"Customer"})),...rows("products").map(x=>({...x,_type:"Product"})),...rows("services").map(x=>({...x,_type:"Service"}))];return all.filter(x=>(kind==="all"||x._type.toLowerCase()===kind)&&JSON.stringify(x).toLowerCase().includes(text))},[q,kind,rows]);return <><div className="search"><input autoFocus placeholder="Invoice number, customer, product, service…" value={q} onChange={e=>setQ(e.target.value)}/></div><div className="filters">{["all","invoice","customer","product","service"].map(x=><button className={kind===x?"selected":""} onClick={()=>setKind(x)} key={x}>{nice(x)}</button>)}</div>{q&&<List rows={found}/>} {!q&&<Empty text="Search live Firebase records by invoice number, customer, product, or service."/>}</>}
function Reports({invoices,products,customers}:{invoices:Row[];products:Row[];customers:Row[]}){const total=invoices.reduce((s,x)=>s+Number(x.total||0),0),gst=invoices.reduce((s,x)=>s+Number(x.gst||x.tax||0),0);return <><div className="metrics">{[["Total sales",rupee(total)],["Invoices",invoices.length],["GST",rupee(gst)],["Customers",customers.length],["Inventory value",rupee(products.reduce((s,x)=>s+Number(x.stock||0)*Number(x.cost_price||0),0))]].map(([l,v])=><div className="panel" key={String(l)}><small>{l}</small><b>{v}</b></div>)}</div><section><h3>REVENUE · LAST 14 DAYS</h3><div className="panel bars"><b>{rupee(total)}</b><div>{Array.from({length:14},(_,n)=><i key={n} style={{height:`${15+(n%5)*18}%`}}/>)}</div></div></section><section><h3>RECENT INVOICES</h3><List rows={invoices.slice(0,20)}/>{!invoices.length&&<Empty text="No invoice data yet."/>}</section></>}
function Settings({user,rows,save}:{user:User;rows:Row[];save:(n:string,v:any,id?:string)=>Promise<string>}){const s=rows[0], [name,setName]=useState(s?.businessName||"");return <><div className="panel settings"><h3>Business Workspace</h3><label>Business name<input placeholder="Business name" value={name} onChange={e=>setName(e.target.value)}/></label><button onClick={()=>save("settings",{businessName:name},s?.id)}>Save Settings</button></div><div className="panel settings"><h3>Account</h3><p>{user.email}</p><p className="subhead">Firebase project: {app.options.projectId}<br/>App ID: {app.options.appId}<br/>Database: {FIRESTORE_DATABASE_ID}<br/>UID: {user.uid}</p></div><div className="panel settings"><h3>Coupon Management</h3><p>Open Coupons from the navigation to create and manage discounts.</p></div></>}
function POS({user,products,customers,coupons,go}:{user:User;products:Row[];customers:Row[];coupons:Row[];go:(x:Page)=>void}){const[cart,setCart]=useState<Row[]>([]),[customer,setCustomer]=useState(""),[coupon,setCoupon]=useState(""),[payLater,setPayLater]=useState(false),[busy,setBusy]=useState(false);const sub=cart.reduce((s,x)=>s+Number(x.selling_price||0),0);const c=coupons.find(x=>x.code===coupon.trim().toUpperCase()&&x.enabled!==false);const discount=c?(c.discountType==="percentage"?sub*Number(c.discount)/100:Number(c.discount)):0;const bill=async()=>{if(!cart.length)return alert("Add at least one product.");if(coupon&&!c)return alert("Coupon not found or disabled. Leave it empty to bill without a coupon.");setBusy(true);try{const now=new Date().toISOString(),id=doc(collection(db,...recordPath(user.uid,"invoices"))).id,invoiceRef=doc(db,...recordPath(user.uid,"invoices"),id),customerRef=customer?doc(db,...recordPath(user.uid,"customers"),customer):null,items=Object.values(cart.reduce((a:Record<string,any>,p)=>{a[p.id]=a[p.id]?{...a[p.id],quantity:a[p.id].quantity+1}: {product_id:p.id,name:p.name,quantity:1,price:Number(p.selling_price||0),shop_id:p.shop_id||""};return a},{}));const total=Math.max(0,sub-discount),invoice={id,invoice_number:`INV-${Date.now()}`,items,customer_id:customer||null,customer_name:customers.find(x=>x.id===customer)?.name||"Walk-in",subtotal:sub,discount,total,amount_paid:payLater?0:total,balance_due:payLater?total:0,status:payLater?"pending":"paid",payment_method:payLater?"pay_later":"cash",created_at:now,shop_id:items[0]?.shop_id||""};await runTransaction(db,async t=>{const productRefs=items.map((item:any)=>doc(db,...recordPath(user.uid,"products"),item.product_id));const reads=await Promise.all([t.get(invoiceRef),...(customerRef?[t.get(customerRef)]:[]),...productRefs.map(ref=>t.get(ref))]);const invoiceSnap=reads[0],customerSnap=customerRef?reads[1]:null,productSnaps=reads.slice(customerRef?2:1);if(invoiceSnap.exists())throw Error("Invoice number collision. Please retry.");if(customerRef&&!customerSnap?.exists())throw Error("Selected customer no longer exists.");for(let i=0;i<items.length;i++){const snap=productSnaps[i],item:any=items[i];if(!snap.exists())throw Error(`${item.name} no longer exists.`);const stock=Number(snap.data().stock||0);if(stock<item.quantity)throw Error(`Insufficient stock for ${item.name}`);t.update(productRefs[i],{stock:stock-item.quantity,updatedAt:now});const move=doc(collection(db,...recordPath(user.uid,"inventoryMovements")));t.set(move,clean({id:move.id,productId:item.product_id,productName:item.name,branchId:item.shop_id,type:"SALE",quantityDelta:-item.quantity,previousQuantity:stock,newQuantity:stock-item.quantity,invoiceId:id,createdAt:now,uid:user.uid}));}t.set(invoiceRef,clean(invoice));t.set(doc(db,...recordPath(user.uid,"payments"),id),clean({id,invoice_id:id,invoice_number:invoice.invoice_number,amount:invoice.amount_paid,status:invoice.status,created_at:now}));t.set(doc(db,...recordPath(user.uid,"sales"),id),clean({id,invoice_id:id,invoice_number:invoice.invoice_number,total:invoice.total,status:invoice.status,created_at:now}));if(customerRef)t.update(customerRef,{total_purchases:increment(invoice.total),total_paid:increment(invoice.amount_paid),total_due:increment(invoice.balance_due)});});alert(`Invoice ${invoice.invoice_number} saved.`);go("invoices")}catch(e:any){console.error("Invoice transaction failed",e);alert(e.message||"Invoice was not saved.")}finally{setBusy(false)}};return <><p className="subhead">Coupon is optional. The sale reads every invoice/customer/product reference before writing anything.</p><div className="pos"><section className="panel"><h3>Products</h3>{products.map(p=><button className="product" disabled={Number(p.stock)<=0} onClick={()=>setCart([...cart,p])} key={p.id}><span>{p.name}</span><b>{rupee(p.selling_price)} · {p.stock} left</b></button>)}</section><section className="panel"><h3>New Sale</h3><select value={customer} onChange={e=>setCustomer(e.target.value)}><option value="">Walk-in customer</option>{customers.map(c=><option value={c.id} key={c.id}>{c.name}</option>)}</select><div className="cart">{cart.map((p,n)=><p key={`${p.id}-${n}`}>{p.name}<b>{rupee(p.selling_price)}</b></p>)}{!cart.length&&<p>No items yet.</p>}</div><input placeholder="Optional coupon" value={coupon} onChange={e=>setCoupon(e.target.value)}/><label className="check"><input type="checkbox" checked={payLater} onChange={e=>setPayLater(e.target.checked)}/> Pay later</label><p>Subtotal <b>{rupee(sub)}</b> · Discount <b>{rupee(discount)}</b></p><h2>{rupee(total)}</h2><button disabled={busy} onClick={bill}>{busy?"Saving…":"Complete Bill"}</button></section></div></>}
function Returns({invoices,user}:{invoices:Row[];user:User}){return <><p className="subhead">Returns must be linked to an existing invoice; stock restoration remains a controlled transaction in the mobile workflow.</p><List rows={invoices.filter(x=>x.status!=="returned")}/>{!invoices.length&&<Empty text="No invoices available for a return."/>}</>}
function Fields({form,set,fields}:{form:any;set:(x:any)=>void;fields:string[][]}){return <>{fields.map(([l,k,t])=><label key={k}>{l}<input type={t||"text"} value={form[k]||""} onChange={e=>set({...form,[k]:e.target.value})}/></label>)}</>};function Modal({title,close,children}:{title:string;close:()=>void;children:React.ReactNode}){return <div className="modal"><div><header><h2>{title}</h2><button onClick={close}>×</button></header>{children}</div></div>};function Empty({text}:{text:string}){return <div className="empty panel">{text}</div>}
createRoot(document.getElementById("root")!).render(<App/>);
